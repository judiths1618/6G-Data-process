# Dockerfile.wavestitch-gpu
# WaveStitch GPU Docker Image - S3 Only Storage
# Build via the helper script (it vendors the preprocess helper into context):
#     bash build_image.sh            # from dockers/tools/  (needs nvidia-docker host)
# (A bare `docker build` fails the _wsp_helpers/ COPY unless you vendor it first.)

FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

RUN ln -sf /usr/bin/python3 /usr/local/bin/python && \
    ln -sf /usr/bin/pip3 /usr/local/bin/pip

LABEL description="WaveStitchPlus GPU Image - S3 Storage Only"

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget build-essential \
    python3 python3-pip python3-venv python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir -U pip setuptools wheel

RUN python -m pip install --no-cache-dir \
  torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

# copy requirements
COPY requirements.txt /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy WaveStitch 代码
COPY WaveStitchPlus_app/ /app/WaveStitchPlus_app/

COPY scripts/run_pipeline.py /app/run_pipeline.py

# Bundle the canonical preprocess helper so the WaveStitchPlus shim
# (WaveStitchPlus_app/custom_pipeline/preprocess.py) resolves it standalone — it
# adds `<app>/../../airflow/dags/helpers` → /airflow/dags/helpers (in-image) to
# sys.path. The file is outside this build context; build_image.sh vendors it
# into ./_wsp_helpers/ before building.
COPY _wsp_helpers/preprocess.py /airflow/dags/helpers/preprocess.py

# Use /tmp as a temporary working directory
# (automatically cleaned up after the container is destroyed).
ENV WORK_DIR=/tmp/wavestitch

# 默认命令
CMD ["python", "/app/run_pipeline.py"]